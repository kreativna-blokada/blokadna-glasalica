[sub_resource type="Shader" id="Shader_vivid_colors"]
code = "shader_type canvas_item;

//screen behind the overlay, read back to strengthen its colours
uniform sampler2D screen_texture : hint_screen_texture, filter_nearest;
uniform float saturation : hint_range(1.0, 3.0) = 1.5;

void fragment() {
	vec3 screen_color = texture(screen_texture, SCREEN_UV).rgb;
	float luminance = dot(screen_color, vec3(0.299, 0.587, 0.114));
	COLOR = vec4(clamp(mix(vec3(luminance), screen_color, saturation), 0.0, 1.0), 1.0);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vivid_colors"]
shader = SubResource("Shader_vivid_colors")
shader_parameter/saturation = 1.5

